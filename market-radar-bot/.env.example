# =============================================================================
# MARKET RADAR BOT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./market_radar.db

# -----------------------------------------------------------------------------
# Admin Panel Authentication
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_secure_password_123
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars

# -----------------------------------------------------------------------------
# Telegram Notifications
# -----------------------------------------------------------------------------
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get your chat ID by messaging @userinfobot or your bot
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# OpenRouter LLM (Optional - system works without this in rules-only mode)
# -----------------------------------------------------------------------------
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model to use (default: anthropic/claude-3-haiku, alternatives: openai/gpt-4o-mini, google/gemini-flash-1.5)
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Detection & Alerting Thresholds
# -----------------------------------------------------------------------------
# Severity score (0-100) above which an immediate alert is sent
ALERT_THRESHOLD=70
# Severity score (0-100) above which events are included in digest
DIGEST_THRESHOLD=30
# Minimum LLM confidence to consider a match valid
LLM_CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Polling & Cooldowns
# -----------------------------------------------------------------------------
# How often to poll sources (in seconds)
POLL_INTERVAL_SECONDS=60
# Default cooldown between alerts for the same watch item (in minutes)
DEFAULT_COOLDOWN_MINUTES=15
# Max text length to store (characters)
MAX_TEXT_LENGTH=50000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
